# Public Remotive endpoint. No API key is required for this source.
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs

# Keyword matched against job title and description.
JOB_SEARCH_TERM=Data Engineer

# Reserved for a later authenticated source. Not used by the Remotive extractor.
# JOB_API_KEY=

# Where silver and gold Delta tables are written: local (default) or azure.
STORAGE_TYPE=local

# Required when STORAGE_TYPE=azure. The pipeline writes to
# abfss://<container>@<account>.dfs.core.windows.net/processed/delta
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=
# Shared key for a local Spark session. On Azure, managed identity can replace this.
# AZURE_STORAGE_ACCOUNT_KEY=
